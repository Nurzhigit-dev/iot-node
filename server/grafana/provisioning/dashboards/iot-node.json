{
  "uid": "iot-node",
  "title": "IoT Node",
  "description": "BMP180 readings from the ESP32-S3 node, delivery delay and device status.",
  "tags": [
    "iot-node"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 42,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "influxdb",
        "hide": 2,
        "current": {},
        "options": [],
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Temperature",
      "description": "Every reading, stamped with the time it was measured on the device. A real gap in the data shows as a break in the line.",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.node}",
          "unit": "celsius",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 5,
            "insertNulls": 20000,
            "spanNulls": false
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r._field == \"temperature\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Pressure",
      "description": "Every reading, stamped with the time it was measured on the device. A real gap in the data shows as a break in the line.",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.node}",
          "unit": "pressurehpa",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 5,
            "insertNulls": 20000,
            "spanNulls": false
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r._field == \"pressure\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Delivery delay",
      "description": "How long after the measurement each reading reached the server. About 0 s normally. Readings measured while the server was unreachable were kept in the device's flash buffer and delivered after reconnecting: they show up here as a ramp.",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 15,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.node}",
          "unit": "suffix: s",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "always",
            "pointSize": 5,
            "insertNulls": 20000,
            "spanNulls": false,
            "axisSoftMin": 0,
            "axisLabel": "seconds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r._field == \"delay_s\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Device status",
      "description": "Messages on the status topic: \"online, fw <version>\" after every (re)connect, \"offline\" from the Last Will when the device disappears.",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 15,
        "y": 9,
        "w": 9,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "^online.*",
                "result": {
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "offline": {
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Node"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"status\" and r._field == \"value\")\n  |> group()\n  |> keep(columns: [\"_time\", \"node\", \"_value\"])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> rename(columns: {_time: \"Time\", node: \"Node\", _value: \"Status\"})"
        }
      ]
    }
  ]
}
